{
  "manifest_version": 2,
  "name": "Sanction Form Extension!!!",
  "version": "1.0.0",
  "description": "This extension helps you to guide for Customer SOP as well as General SOP Intructions",
  "content_security_policy": "script-src 'self' https://ajax.googleapis.com; object-src 'self'",   
   "icons": 
	{ 
		"16": "icon.png",
        "48": "icon.png",
        "128": "icon.png" 
	},
  "content_scripts": [
    {
	
		"js": [ "JQ.js", "Akshay.js", "functions.js" ], 
		
		"css": [ "akshay.css" ],
		
		"matches": [ "https://www.appsheet.com/*", "http://www.appsheet.com/*" ],

		"Permission": [ "tabs" ],

		"all_frames": true,

		"run_at": "document_end"
    }
  ]
}

