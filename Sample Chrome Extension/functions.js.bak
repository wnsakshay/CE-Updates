function BlackList()
{
	var SHC = "";
	var SHCC = "";
	var CNC = "";
	var CNCC = "";
	var NTC = "";
	var NTCC = "";
	var FWC = "";
	var FWCC = "";
	var ANTC = "";
	var ANTCC = "";
	
	if(document.getElementsByName("sh_cust_cnt_cd")[0].value != null)
	{
		SHC = document.getElementsByName("sh_cust_cnt_cd")[0].value;
	}

	if(document.getElementsByName("sh_cust_seq")[0].value != null)
	{
		SHCC = document.getElementsByName("sh_cust_seq")[0].value;
	}

	if(document.getElementsByName("cn_cust_cnt_cd")[0].value != null)
	{
		CNC = document.getElementsByName("cn_cust_cnt_cd")[0].value;
	}
	
	if(document.getElementsByName("cn_cust_seq")[0].value != null)
	{
		CNCC = document.getElementsByName("cn_cust_seq")[0].value;
	}
	
	if(document.getElementsByName("nf_cust_cnt_cd")[0].value != null)
	{
		NTC = document.getElementsByName("nf_cust_cnt_cd")[0].value;
	}
	
	if(document.getElementsByName("nf_cust_seq")[0].value != null)
	{
		NTCC = document.getElementsByName("nf_cust_seq")[0].value;
	}
	
	if(document.getElementsByName("ff_cust_cnt_cd")[0].value != null)
	{
		FWC = document.getElementsByName("ff_cust_cnt_cd")[0].value;
	}
	
	if(document.getElementsByName("ff_cust_seq")[0].value != null)
	{
		FWCC = document.getElementsByName("ff_cust_seq")[0].value;
	}
	
	if(document.getElementsByName("an_cust_cnt_cd")[0].value != null)
	{
		ANTC = document.getElementsByName("an_cust_cnt_cd")[0].value;
	}
	
	if(document.getElementsByName("an_cust_seq")[0].value != null)
	{
		ANTCC = document.getElementsByName("an_cust_seq")[0].value;
	}
	
	if(SHC == "CN" || CNC == "CN" || NTC == "CN" || FWC == "CN" || ANTC == "CN")
	{
		if(SHCC == "168626" || SHCC == "545325" || CNCC == "168626" || CNCC == "545325" || NTCC == "168626" || NTCC == "545325" || FWCC == "168626" || FWCC == "545325" || ANTCC == "168626" || ANTCC == "545325")
		{
			window.prompt("Black listed customer found!!!")
		}
	}
	if(SHC == "PA" || CNC == "PA" || NTC == "PA" || FWC == "PA" || ANTC == "PA")
	{
		if(SHCC == "501179" || CNCC == "501179" || NTCC == "501179" || FWCC == "501179" || ANTCC == "501179" )
		{
			window.prompt("Black listed customer found!!!")
		}
	}
}

function ToOrderSanction()
{
	var cName = document.getElementsByName("cn_cust_nm")[0].value;
	
	if(cName.includes("TO ORDER OF").replace("\r\n"))
	{
		window.alert("Create Sanction check form for TO ORDER OF BANK");
	}
}

function Hyundai_Glovis()
{
	db.transaction(
		function(tx){
			tx.executeSql('SELECT CNPTName, SCNo, RFANo FROM Customer ORDER BY ROWID DESC LIMIT 1 ;', [],
			function(transaction, results){
				if (results != null && results.rows != null) 
				{
					for (var j=0; j<results.rows.length; j++) 
					{
						var row = results.rows.item(j) ;
						cnptName = row.CNPTName;
						SCNo = row.SCNo;
						RFANo = row.RFANo;
						if(cnptName.includes("HYUNDAI GLOVIS"))
						{
							if(SCNo == "SEL0015B22" || SCNo == "SEL0160N22" || SCNo == "SELN02370A" || SCNo == "SELB02382A" || RFANo == "SEL0015B22" || RFANo == "SEL0160N22" || RFANo == "SELN02370A" || RFANo == "SELB02382A" )
							{
								alert("Application Date is same as On Board Date.")
							}
						}
					}
				}
			}
		);
		}
	);
}


function ar_invoice()
{
	var title = document.getElementById("title").innerHTML;
	if(title == "Miscellaneous Revenue Invoice Creation ( FNS_INV_0071-01 )")
	{
		var bl = document.getElementsByName("bl_no")[0].value;
		if(bl != "")
		{
			var office = document.getElementById("ar_ofc_cd_text").value;
			if(bl.substring(0,2) == "CK" || bl.substring(0,2) == "NK" || bl.substring(0,2) == "WU")
			{
				if(office != "NKGBB")
				{
					window.prompt("Please select correct Office");
				}
			}
			else if(bl.substring(0,2) == "SH")
			{
				if(office != "SHABB")
				{
					window.prompt("Please select correct Office");
				}
			}
			else if(bl.substring(0,2) == "NB")
			{
				if(office != "NBOBB")
				{
					window.prompt("Please select correct Office");
				}
			}
			else if (bl.substring(0,2) == "TA")
			{
				if(office != "TAOBB")
				{
					window.prompt("Please select correct Office");
				}
			}
			else if(bl.substring(0,2) == "TS")
			{
				if(office != "TSNBB")
				{
					window.prompt("Please select correct Office");
				}
			}
			else if(bl.substring(0,2) == "DLCBB")
			{
				if(office != "DLCBB")
				{
					window.prompt("Please select correct Office");
				}
			}
		
		}
	}
}

function MnDReefer()
{
	var reefer = document.getElementsByName("cntr_cmdt_desc")[0].value;
	
	if(reefer.includes("HR CONTAINER") || reefer.includes("RF CONTAINER") || reefer.includes("RH CONTAINER"))
	{
		alert("Please update Temperature as per SI");
	}
}

function ChargePopup_USCA()
{
	var POD = document.getElementById('frm_t10sheet1_pod_cd').value.substring(0,2);
	
	if(POD == "US" || POD == "CA")
	{
		alert("Please Check AMS/CDD/ACI charge");
	}
}

function SOC_CMDTPopup()
{
	setTimeout(function(){
	var s = document.querySelector("#t1sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMWrap0.GMAlignRight.GMFloat.GMCell.IBSheetFont0.HideCol0C7").innerHTML;
	if(s  !== "0.00")
	{
		alert("SOC Container found please check CMDT");
	}
},5000);
	
}