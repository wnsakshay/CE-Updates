function getPONumber()
{
	var CNEEName = "";
	
	db.transaction 
	(
		function(tx)
		{
			tx.executeSql('SELECT * FROM Customer ORDER BY ROWID DESC LIMIT 1 ;', [],
			function(transaction, results)
			{
				if (results != null && results.rows != null) 
				{
					for (var j=0; j<results.rows.length; j++) 
					{
						var row = results.rows.item(j) ;
						BLNumber = row.BLNumber;
						//console.log('BLNumber '+ BLNumber);
						CNEEName = row.CNEEName;
						var firstWord = CNEEName.replace(/ .*/,'');
						console.log('firstWord '+ firstWord);
						var p = firstWord.substr(0,2);
							
						if(document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassFocusedCell.GMWrap0.GMAlignLeft.GMText.GMCell.IBSheetFont0.HideCol0C3") != null)
						{
							var PON = document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassFocusedCell.GMWrap0.GMAlignLeft.GMText.GMCell.IBSheetFont0.HideCol0C3").innerHTML;
						}
						if(document.getElementById("_editInput0") != null)
						{
							var PON1 = document.getElementById("_editInput0").value;
						}
						if(document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassFocusedCell.GMWrap0.GMAlignLeft.GMText.GMCell.IBSheetFont0.GMEmpty.HideCol0C3") != null )
						{
							var PON2 = document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassFocusedCell.GMWrap0.GMAlignLeft.GMText.GMCell.IBSheetFont0.GMEmpty.HideCol0C3").innerHTML;
						}
						var bkpo = document.getElementsByName("bkpo")[0].value;
						
						if( firstWord == "COSTCO" )
						{
							if(bkpo == "")
							{
								alert("Please Enter PO Number for Costco Customer.");
							}
							if(bkpo == PON)
							{
								document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassFocusedCell.GMWrap0.GMAlignLeft.GMText.GMCell.IBSheetFont0.HideCol0C3").style.backgroundColor = red;
								alert('PO Number abd Container PO Number should be same.');
							}
						}
						if(firstWord == "WALMART" || firstWord.substr(0,3) == "WAL-")
						{
							//console.log('wal mart in : ' + bkpo);
							if(bkpo == "")
							{
								alert("Please Enter PO Number for Walmart Customer.");
							}
							if( PON == "&nbsp;" || PON == "")
							{
								//document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassFocusedCell.GMWrap0.GMAlignLeft.GMText.GMCell.IBSheetFont0.HideCol0C3").style.backgroundColor = red;
								//document.querySelector("#_editInput0");
								alert('PO Number and Container PO Number should be same.');
							}
						}
					}
				}
			});
		}
	);

}

function UpdateApplicationDate()
{
	if(document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassReadOnly.GMClassFocusedCell.GMWrap0.GMAlignCenter.GMText.GMCell.IBSheetFont0.HideCol0C2") != null) {
		var BLNumber = document.querySelector("#sheet1 > tbody > tr:nth-child(2) > td > div > div.GMPageOne > table > tbody > tr.GMDataRow.GMClassFocused > td.GMClassReadOnly.GMClassFocusedCell.GMWrap0.GMAlignCenter.GMText.GMCell.IBSheetFont0.HideCol0C2").innerHTML;	
	}
	
	var App_Date = document.getElementById("apply_dt").value;
	
    db.transaction(function(t) {
        t.executeSql(' UPDATE Customer SET App_Date = "' + App_Date + '"  where BLNumber = "'+ BLNumber +'"   ');
    });	
}

function UpdateTransMode()
{
	if(document.getElementsByName("pod_loc_cd")[0] != null)
	{
		var POD = document.getElementsByName("pod_loc_cd")[0].value;
	}
	if(document.getElementsByName("por_loc_cd")[0] != null)
	{
		var POR = document.getElementsByName("por_loc_cd")[0].value;
	}
	if(document.getElementsByName("pol_loc_cd")[0] != null)
	{
		var POL = document.getElementsByName("pol_loc_cd")[0].value;
	}
	if(document.getElementsByName("combo1_text")[0] != null)
	{
		var	Trans_Mode = document.getElementsByName("combo1_text")[0].value;
	}
	
    db.transaction(function(t) {
        t.executeSql(' UPDATE Customer SET Trans_Mode = "' + Trans_Mode + '"  where POR = "'+ POR +'"   ');
    });			
}

function ValidateMail()
{
	var rtn_to_usr_eml;
	if(document.getElementsByName("rtn_to_usr_eml")[0] != null)
	{
		rtn_to_usr_eml = document.getElementsByName("rtn_to_usr_eml")[0].value;
	}

	var radios = document.getElementsByName('ui_grp_cd');
	var emailArray = rtn_to_usr_eml.split(";");

	for (var i = 0, length = radios.length; i < length; i++)
	{
		if (radios[i].checked)
		{
			if(radios[i].value == "C")
			{
				console.log('Customer chk ' + radios[i].value);
				for (i = 0; i <= (emailArray.length-1 ) ; i++)
				{
					console.log(emailArray[i]);
					if((emailArray[i] == "HK.Escalate.exp@one-line.com" || emailArray[i] == "Cn.SX.Escalate.exp@one-line.com" || emailArray[i] == "Cn.GZ.Escalate.exp@one-line.com" || emailArray[i] == "Cn.ZS.Escalate.exp@one-line.com"))
					{
						alert("Do not use Onshore Email Id's here.");
					}
				}
				break;
			}
			
			if(radios[i].value == "J")
			{
				console.log('Onshore chk ' + radios[i].value);
				for(i = 0; i<= (emailArray.length-1 ) ; i++)
				{
					console.log(emailArray[i]);
					if(emailArray[i] == "hk.ons.exp@one-line.com" || emailArray[i] == "cn.sx.ons.exp@one-line.com" || emailArray[i] == "cn.gz.ons.exp@one-line.com" || emailArray[i] == "cn.zs.ons.exp@one-line.com")
					{
						alert("Do not use Customer Email Id's here.");
					}
				}
				break;
			}
			break;
		}
	}	
}

function CheckEscalationMail()
{
	var rtn_to_usr_eml = document.getElementsByName("rtn_to_usr_eml")[0];
	var BLNumber = "";
	var BOFC = "";	
	var radios = document.getElementsByName('ui_grp_cd');

	for (var i = 0, length = radios.length; i < length; i++)
	{
		if (radios[i].checked)
		{
			//alert(radios[i].value);
			db.transaction 
			(
				function(tx)
				{
					tx.executeSql('SELECT * FROM Escalation ORDER BY ROWID DESC LIMIT 1 ;', [],
					function(transaction, results)
					{
						if (results != null && results.rows != null) 
						{
							for (var j=0; j<results.rows.length; j++) 
							{
								var row = results.rows.item(j) ;
								BLNumber = row.BLNumber;
								console.log('BLNumber '+ BLNumber);
								BOFC = row.BOFC;
								console.log('BOFC '+ BOFC);
								
								if(radios[i].value == "C")
								{
									if(BOFC == "HKGBB" )
									{
										rtn_to_usr_eml.value += "; hk.ons.exp@one-line.com";
									}
									if(BOFC == "SZPBB" )
									{
										rtn_to_usr_eml.value += "; cn.sx.ons.exp@one-line.com";
									}
									if(BOFC == "CANBB" )
									{
										rtn_to_usr_eml.value += "; cn.gz.ons.exp@one-line.com";									
									}
									if(BOFC == "ZHOBB" )
									{
										rtn_to_usr_eml.value += "; cn.zs.ons.exp@one-line.com";
									}
								}
							
								if(radios[i].value == "J")
								{
									if(BOFC == "HKGBB" )
									{
										rtn_to_usr_eml.value += "; HK.Escalate.exp@one-line.com";
									}
									if(BOFC == "SZPBB" )
									{
										rtn_to_usr_eml.value += "; CN.SX.Escalate.exp@one-line.com";
									}
									if(BOFC == "CANBB" )
									{
										rtn_to_usr_eml.value += "; CN.GZ.Escalate.exp@one-line.com";
									}
									if(BOFC == "ZHOBB" )
									{
										rtn_to_usr_eml.value += "; CN.ZS.Escalate.exp@one-line.com";
									}
								}
							}
						}
					});
				}
			);
			break;	
		}
	}
}

function InsertEscalationMail()
{
	var BLNumber = document.getElementsByName("bkg_no")[0].value;
	var BOFC;
	
	if(BLNumber.substr(0,2) == "HK" )
	{
		BOFC = "HKGBB";
	}
	if(BLNumber.substr(0,2) == "SZ" )
	{
		BOFC = "SZPBB";
	}
	if(BLNumber.substr(0,2) == "CA" )
	{
		BOFC = "CANBB";
	}
	if(BLNumber.substr(0,2) == "ZH" )
	{
		BOFC = "ZHOBB";
	}
	console.log('BL Number :' +  BLNumber + ' BKG OFC : '+ BOFC);
		
	db.transaction(function(t) 
	{
        t.executeSql("delete from Escalation");
	});
	
    db.transaction(function(t) 
	{
		t.executeSql("Insert into Escalation (BLNumber, BOFC) values (?, ?)", [BLNumber, BOFC] , nullDataHandler, killTransaction);
    });
	function nullDataHandler(transaction, results)   
	{

    }
    function killTransaction(transaction, error) 
	{

    }
}

function DocCheck()
{
 	var shprName = "";
	var BLNumber = "";	
	var POD = "";
	
	db.transaction 
	(
		function(tx)
		{
			tx.executeSql('SELECT * FROM CUSTOMER ORDER BY ROWID DESC LIMIT 1 ;', [],
			function(transaction, results)
			{
				if (results != null && results.rows != null) 
				{
					for (var j=0; j<results.rows.length; j++) 
					{
						var row = results.rows.item(j) ;
						shprName = row.SHPRName;
						console.log('Shipper Name '+ shprName);
						var BL = row.BLNumber;
						console.log('BL Number '+BLNumber);
						var POD = row.POD;
						console.log('POD '+POD);
												
						if(POD.includes("BR"))
						{
							if(document.getElementById("bl_tp_cd2") != null)
							{
								if(document.getElementById("bl_tp_cd2").checked != true )
								{
									alert("Please Select O.BL");
								}
							}
						}
						if(POD == "BJCOO" || POD == "CIABJ" || POD == "GHTEM" || POD == "NGAPP" || POD == "DAKAR" || POD == "CRCAL" || POD == "CRLIO" || POD == "DOCAU" || POD == "GTPRQ" || POD == "GTSTC" || POD == "HNSLO" || POD == "HNPCR" || POD == "SVAQJ" || POD == "VELAG" || POD == "VEPBL" || POD == "VEPSU" || POD == "VEGUT" || POD == "VEGBY" || POD == "VEMAR" || POD == "VEEGU" || POD == "ARBUE" || POD == "PYASU" || POD == "NICIO" || POD == "COBUN" || POD == "COCTG" || POD == "ECGYE" )
						{
							if(document.getElementById("bl_tp_cd2") != null)
							{
								if(document.getElementById("bl_tp_cd2").checked != true )
								{
									alert("Please Select O.BL");
								}
							}
						}				
					}
				}
			});
		}
	);
}

function DGCheck()
{
	if (document.getElementsByName("dg_cmdt_desc")[0] != null) 
	{
        Description = document.getElementsByName("dg_cmdt_desc")[0].value;
    }
	
	var DGWords = ["AIR CONDITIONER","AIRCONDITIONER","AUTOMOBILE","BATTERIES","BATTERY","CHASSIS NO","CHASSIS NUMBER","COTTON","EXPLOSIVE","FIRE CRACKER","FIRE WORK","FIRECRACKERS","FIREWORKS","FISH MEAL"," IMCO ","IMO CLASS","LITHIUM","PING-PONG","POWER BANK","POWERBANK","RECHARGEABLE","REFRIGERATOR","SCOOTER","TABLE TENNIS","UNNO","USED AUTO PARTS","USED CAR","USED VEHICLE","VEHICLE","AUTOMOBILE PARTS ","PARTS OF AUTOMOBILE","AUTOMOBILE SPARE PARTS","SPARE PARTS OF AUTOMOBILE","AUTO PARTS","PARTS OF AUTO","AUTO SPARE PARTS","SPARE PARTS OF AUTO","TRUCK","TRUCK PARTS","PARTS OF TRUCK","USED CAR","USED CAR PARTS","PARTS OF USED CAR","USED VEHICLE PARTS","PARTS OF USED VEHICLE","USED TRUCK","USED TRUCK PARTS","PARTS OF USED TRUCK","VEHICLE","VEHICLE PARTS","PARTS OF VEHICLE","VIVO","VIVO Y20" ];
	
	for (var i = 0; i < DGWords.length - 1; i++) 
	{                                  
        if (Description.includes(DGWords[i]))
		{
            
            if(window.confirm("DG Word found in Desciption. \r\nPlease follow DG Keyword Procedure..."))
			{
				//alert("Please follow DG Keyword Procedure...");
				break;
			}                     
        }
    }
}

