{
	"manifest_version": 3,
	"name": "HKGD E2E Extension...!!!",
	"version": "4.0.13",
	"description": "[Last Update: 4th Sep '26]",
	"key": "",
	"host_permissions": [
		"https://wnsakshay.github.io/*"
	],
	"permissions": [ "tabs" ],
	"background": 
	{
		"service_worker": "service-worker.js"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self';"
	},
	"icons": 
	{ 
		"16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png" 
	},
	"content_scripts": [
    {
		"css": [ "akshay.css", "style.css" ],
	
		"js": [ "JQ.js", "Data.js", "functions.js", "BgColor.js", "goi.js" ], 

		"matches": [ "https://cntr.one-line.com/*", "https://mail.google.com/*" ],

		"all_frames": true,

		"run_at": "document_end"
    }
  ]
}

