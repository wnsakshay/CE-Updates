function getCustomerSOP()
{	
	var cnee = "";
	try{
	cnee = document.getElementById("cn_cust_nm").value;
	}
	catch(err)
	{
		
	}
	
	if(cnee.includes("COSTCO"))
	{
		document.getElementById("ex_cust_nm").title =  "PO number: show in 'Export Ref'. for all Costco Shipment in customer Tab.";
	}
	else
	{
		document.getElementById("ex_cust_nm").title = "Update if mentioned on SI.\r\n(Update as per any special customers requirement or Instructions).";
	}
}

