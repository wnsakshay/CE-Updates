{
  "manifest_version": 3,
  "name": "EUA Export Docs Extension!",
  "version": "1.0.7",
  "description": "This extension helps you to guide for Customer SOP as well as General SOP Intructions. [Last updated: 5th Nov'2024]",
  "key": "",
  "permissions": [ "tabs" ],
  "content_security_policy": 
  {
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
  },
  
  "content_scripts": [
    {
      "js": [ "Data.js","functions.js", "BgColor.js" ], 
	  
	  "css": [ "akshay.css" ],

      "matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

      "all_frames": true,

      "run_at": "document_end"
    }
  ]
}

