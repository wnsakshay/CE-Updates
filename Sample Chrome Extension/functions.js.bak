function VIPCust_popup()
{
	var SHPRName = "";
	var FWDRName = "";	
	var CNEEName = "";
	var CNPTName = "";
	
	db.transaction 
	(
		function(tx)
		{
			tx.executeSql('SELECT * FROM CUSTOMER ORDER BY ROWID DESC LIMIT 1 ;', [],
			function(transaction, results)
			{
				if (results != null && results.rows != null) 
				{
					for (var j=0; j<results.rows.length; j++) 
					{
						var row = results.rows.item(j) ;
						SHPRName = row.SHPRName;
						FWDRName = row.FWDRName;
						CNEEName = row.CNEEName;
						CNPTName = row.CNPTName;

						if(SHPRName.includes("TOYOTA") || FWDRName.includes("TOYOTA") || CNEEName.includes("TOYOTA") || CNPTName.includes("TOYOTA"))
						{
							alert("This is VIP customer, please recheck entire information carefully, Any errors are strictly prohibited.");	
						}
					}
				}
			});
		}
	);
}

