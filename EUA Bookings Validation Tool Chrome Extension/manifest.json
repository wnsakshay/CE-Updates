{
  "manifest_version": 3,
  "name": "EUA Bookings Validation Tool!",
  "version": "1.0.4",
  "description": "Last Updated: 4th Dec '25",
  "key": "",
  "host_permissions": [
		"https://wnsakshay.github.io/*"
	],
	"permissions": [ "tabs" ],
	"background": 
	{
		"service_worker": "service-worker.js"
	},
  "content_security_policy": 
  {
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
  },
  "content_scripts": [
    {
      "js": [ "Data.js","functions.js", "BgColor.js" ], 
	  
	  "css": [ "akshay.css" ],

      "matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

      "all_frames": true,

      "run_at": "document_end"
    }
  ],
  "icons": 
	{ 
		"16": "assets/icon1.png",
		"48": "assets/icon1.png",
		"128": "assets/icon1.png"
	},
	"author": {
		"email": "akshay.surve@wns.com",
		"copyright": "© 2025 WNS. All rights reserved."
	}
}

