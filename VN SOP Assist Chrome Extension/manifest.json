{
  "manifest_version": 3,
  "name": "VN SOP Assist Chrome Extension",
  "version": "1.0.2",
  "description": "Last updated on: 25th Mar, 2026",
  "key": "",
  "host_permissions": [
		"https://wnsakshay.github.io/*"
	],
	"permissions": [ "tabs", "activeTab", "scripting" ],
	"background": 
	{
		"service_worker": "service-worker.js"
	},
  "content_security_policy": 
  {
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
  },
  "content_scripts": [
    {
      "js": [ "data.js","functions.js", "bgColor.js" ], 
	  
	  "css": [ "styles.css" ],

      "matches": [ "https://cntr.one-line.com/opuscntr/*", "http://cntr.one-line.com/opuscntr/*"],

      "all_frames": true,

      "run_at": "document_end"
    }
  ]
}

