{
  "manifest_version": 3,
  "name": "HKGD BL Release Team Chrome Extension!!!",
  "version": "1.0.2",
  "description": "This extension helps you to guide for Customer SOP as well as General SOP Intructions (Last Updated on 2023-08-21)",
  "key": "",
