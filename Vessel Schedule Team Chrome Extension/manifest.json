{
  "manifest_version": 3,
  "name": "Vessel Schedule Team Chrome Extension",
  "version": "1.0.0",
  "description": "Last update: 3rd Mar '26",
  "key": "",
  "host_permissions": [
		"https://wnsakshay.github.io/*"
	],
  "permissions": [ "tabs" ],
  "background": 
	{
		"service_worker": "service-worker.js"
	},
  "content_security_policy": 
  {
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
  },
  "content_scripts": [
    {
      "js": [ "JQ.js", "Data.js","functions.js", "BgColor.js" ], 
	  
	  "css": [ "akshay.css" ],

      "matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

      "all_frames": true,

      "run_at": "document_end"
    }
  ]
}

