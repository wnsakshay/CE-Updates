{
  "manifest_version": 3,
  "name": "Booking Validation Tool With CSOP...",
  "version": "6.6",
  "description": "This Extension is used for Booking Validation as well as CSOP Instructions. Last Update on : 24.10.2024",
  "key": "",
  "content_security_policy": 
  {
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
  },

	"icons": 
	{ 
		"16": "icon.png",
        "48": "icon.png",
        "128": "icon.png" 
	},
	
  "content_scripts": [
    {
      "css": [ "MyCSS.css" ],
      "js": [ "Data.js", "Jig1.js", "Filer.js",  "EDI.js" ],

      "matches": [ "https://cntr.one-line.com/*" ],

      "Permission": [ "tabs" ],

      "all_frames": true,

      "run_at": "document_end"
    }
  ]
}

