{
	"manifest_version": 3,
	"name": "CNN Email Team Chrome Extension",
	"version": "1.0.5",
	"description": "Email Team Chrome Extension [Last updated: 9th Sep '26]",
	"key": "",
	"host_permissions": [
		"https://wnsakshay.github.io/*"
	],
	"permissions": [ "tabs" ],
	"background": 
	{
		"service_worker": "service-worker.js"
	},
	"content_scripts": [
    {
		"js": [ "Data.js","functions.js"], 	  
		
		"css": [ "akshay.css" ],

		"matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

		"Permission": [ "tabs" ],

		"all_frames": true,

		"run_at": "document_end"
    }
	]
}

