{
	"manifest_version": 3,
	"name": "Indexing Chrome Extension!!!",
	"version": "2.0.10",
	"description": "This extension helps you to guide for Customer SOP as well as General SOP Intructions[Last update: 8th Jun '26]",
	"key": "",
	"host_permissions": [
		"https://wnsakshay.github.io/*"
	],
	"permissions": [ "tabs" ],
	"background": 
	{
		"service_worker": "service-worker.js"
	},
	"content_security_policy": 
	{
		"script-src": ["self"],
		"object-src": ["self"]   
	},
	"icons": 
	{ 
		"16": "icon.png",
        "48": "icon.png",
        "128": "icon.png" 
	},
	"content_scripts": 
	[
		{
			"js": [ "JQ.js", "Data.js","functions.js"],  
		
			"css": [ "akshay.css" ],

			"matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

			"all_frames": true,

			"run_at": "document_end"
		}
	]
}

