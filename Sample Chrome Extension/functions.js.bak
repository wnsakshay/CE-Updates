function PrepaidOffice()
{
	var preOfc = "";
	var blPre = "";
	
	if(document.getElementById('frm_t10sheet1_bkg_no').value.substr(0,2) == "TA")
	{
		preOfc = "TAOBB";
	}
	else if(document.getElementById('frm_t10sheet1_bkg_no').value.substr(0,2) == "TS")
	{
		preOfc = "TSNBB";
	}
	else if(document.getElementById('frm_t10sheet1_bkg_no').value.substr(0,2) == "DL")
	{
		preOfc = "DLCBB";
	}
	else if(document.getElementById('frm_t10sheet1_bkg_no').value.substr(0,2) == "LY")
	{
		preOfc = "LYGBB";
	}
	else if(document.getElementById('frm_t10sheet1_bkg_no').value.substr(0,2) == "CG")
	{
		preOfc = "CGOBB";
	}
	
	if(document.getElementsByName('frm_p_t10sheet3_ofc_cd')[0].value != preOfc)
	{
		alert("Prepaid Office Discrepancy. Please update correctly.");
	}
}

function PrepaidCode()
{
	var fwCN = "";
	var fwCode = "";
	
	db.transaction (
			function(tx){
			//SHPRCode, SHPRName, FWDRCode, FWDRName, CNEECode, CNEEName, CNPTCode, CNPTName
				tx.executeSql('SELECT * FROM CUSTOMER ORDER BY ROWID DESC LIMIT 1 ;', [],
				function(transaction, results){
					if (results != null && results.rows != null) {
						for (var j=0; j<results.rows.length; j++) {
							var row = results.rows.item(j) ;

							
							fwCN = row.FWDRPrf;
							//console.log('Shipper Name '+ shprName);
							fwCode = row.FWDRCode;
							//console.log(cneeName);
							var chrgePCN = document.getElementsByName('frm_p_t10sheet3_cnt_cd')[0].value;
							var chrgePCode = document.getElementsByName('frm_p_t10sheet3_cust_seq')[0].value;
							
							if(fwCN != chrgePCN || fwCode != chrgePCode)
							{
								alert("Prepaid Code Discrepancy. Please update correctly.");
							}
							
	
						}
					}
				});
		}
	);
}

