{
	"manifest_version": 3,
	"name": "HKG Booking SOP Assist!!!",
	"version": "2.0.4",
	"description": "This extension helps you to guide for Customer SOP as well as General SOP Intructions [Last update: 11th Aug '25]",
	"key": "",
	"permissions": [ "tabs" ],
	"content_security_policy": 
	{
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
	},
	"icons": 
	{ 
		"16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png" 
	},
	"content_scripts": [
    {
	
		"js": [ "JQ.js", "Akshay.js", "functions.js" ], 
		
		"css": [ "akshay.css" ],
		
		"matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

		"all_frames": true,

		"run_at": "document_end"
    }
  ]
}

