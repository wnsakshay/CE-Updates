function getMDTab()
{
	db.transaction(
		function(tx){
			tx.executeSql('SELECT * FROM Customer ORDER BY ROWID DESC LIMIT 1 ;', [],
				function(transaction, results){
					if (results != null && results.rows != null) 
					{
						for (var j=0; j<results.rows.length; j++) 
						{
							var row = results.rows.item(j) ;
							var POD = row.POD.substr(0,2);
							var pkg = document.getElementById('_editInput1').value;
							
							if( POD == "US" || POD == "CA" )
							{
								if(pkg == "PX" || pkg == "BE" || pkg == "SI")
								{
									alert("Do not use PX / BE / SI Package for US-CA Shipment.");
								}
							}
						}
					}
				}
			);
		}
	);
}

