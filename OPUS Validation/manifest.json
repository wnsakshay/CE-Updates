{
  "manifest_version": 2,
  "name": "OPUS VALIDATION Tool",
  "version": "0.2",
  "description": "This Extension is use for Validating the opus fields as well as Highlighting the important fields.",
  "key": "",
  "content_security_policy": "script-src 'self' https://ajax.googleapis.com; object-src 'self'",

  "icons": 
	{ 
		"16": "icon.png",
        "48": "icon.png",
        "128": "icon.png" 
	},
	
  "content_scripts": [
    {
      "css": [ "styles2.css" ],
      "js": [  "Validation_content.js", "Jignesh_Validation.js"  ], 

      "matches": [ "https://cntr.one-line.com/*" ],

      "Permission": [ "tabs" ],

      "all_frames": true,

      "run_at": "document_end"
    }
  ]
}

