{ 
    "name": "jQuery DOM", 
    "version": "2", 
    "description": "Manipulate the DOM when the page is done loading", 
    "background_page": "background.html", 
    "browser_action": { 
        "name": "Manipulate DOM", 
        "icons": ["icon.png"], 
        "default_icon": "icon.png" 
    }, 
    "content_scripts": [ 
        { 
            "js": [ "jquery-3.3.1.min.js", "background.js" ],
             "matches": [ "http://*/*", "https://*/*"]
         }
     ] 
}   