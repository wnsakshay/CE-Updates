{
	"manifest_version": 3,
	"name": "Rating Chrome Extension...!!!",
	"version": "2.0.14",
	"description": "NCN/CCN Rating Chrome Extension [Last Update: 11th Mar '26]",
	"key": "",
	"host_permissions": [
		"https://wnsakshay.github.io/*"
	],
	"permissions": [ "tabs" ],
	"background": 
	{
		"service_worker": "service-worker.js"
	},
	"content_security_policy": 
	{
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
	},
	"icons": 
	{ 
		"16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png" 
	},
	"content_scripts": [
    {
		"js": [ "JQ.js", "Data.js","functions.js" ], 
	  
		"css": [ "akshay.css" ],

		"matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

		"all_frames": true,

		"run_at": "document_end"
    }
  ]
}

