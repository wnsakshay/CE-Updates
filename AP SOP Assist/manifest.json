{
  "manifest_version": 3,
  "name": "Accounts Payable SOP Assist!!!",
  "version": "2.0.0",
  "description": "This extension helps you to guide for Customer SOP as well as General SOP Intructions",
  "key": "",
  "permissions": [ "tabs" ],
  "content_security_policy": 
  {
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
  },
   "icons": 
	{ 
		"16": "icon.png",
        "48": "icon.png",
        "128": "icon.png" 
	},
  "content_scripts": [
    {
	
		"js": [ "JQ.js", "Akshay.js", "functions.js" ], 
		
		"css": [ "akshay.css" ],
		
		"matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

		"all_frames": true,

		"run_at": "document_end"
    }
  ]
}

