		if (SHPRName.replace("\r\n"," ").includes(tran[j]) || CNEEName.replace("\r\n"," ").includes(tran[j]) || NTFYName.replace("\r\n"," ").includes(tran[j]) || ANTFYName.replace("\r\n"," ").includes(tran[j]) || EXPREF.replace("\r\n"," ").includes(tran[j]) || SHPRAdd.replace("\r\n"," ").includes(tran[j]) || CNEEAdd.replace("\r\n"," ").includes(tran[j]) || NTFYAdd.replace("\r\n"," ").includes(tran[j]) || countryOrigin.replace("\r\n"," ").includes(tran[j]))
		{
			window.prompt("Found Transit keyword (BL Issue Tab), Kindly follow transit clause procedure: " + tran[k]);
		}
	}
}

