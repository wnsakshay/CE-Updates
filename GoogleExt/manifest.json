{
  "manifest_version": 2,
  "name": "Google Demo Sample!!!",
  "version": "1.0.0",
  "description": "",
  "content_security_policy": "script-src 'self' https://ajax.googleapis.com; object-src 'self'",   
   "icons": 
	{ 
		"16": "icon.png",
        "48": "icon.png",
        "128": "icon.png" 
	},
  "content_scripts": [
    {
		
		"js": [ "akshay.js"], 
		
		"css": [ "akshay.css" ],
		
		"matches": [ "https://*.google.com/*", "https://chat.google.com/*" ],

		"Permission": [ "tabs" ],

		"all_frames": true,

		"run_at": "document_end"
    }
  ]
}

