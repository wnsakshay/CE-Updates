{
  "manifest_version": 3,
  "name": "Sample Chrome Extension",
  "version": "1.0.0",
  "description": "Sample Description",
   "permissions": [ "tabs" ],
   "author": "Akshay Surve",
  "content_security_policy": 
  {
	  "script-src":  ["self"],
	  "object-src" : ["self"]  
  },
   "icons": 
	{ 
		"16": "iconx16.png",
        "48": "iconx48.png",
        "128": "iconx128.png" 
	},
  "content_scripts": [
    {
      "js": [ "JQ.js", "Data.js","functions.js", "mail.js",  "BgColor.js" ], 
	  
	  "css": [ "akshay.css" ],

      "matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

      "all_frames": true,

      "run_at": "document_end"
    }
  ]
}

