{
	"manifest_version": 3,
	"name": "BL Release Extension!!!",
	"version": "2.0.11",
	"description": "CNN BL Release Chrome Extension [Last Update: 9th Sep '26]",
	"key": "",
	"host_permissions": [
		"https://wnsakshay.github.io/*"
	],
	"permissions": [ "tabs" ],
	"background": 
	{
		"service_worker": "service-worker.js"
	},
	"content_security_policy": 
	{
		"script-src":  ["self"],
		"object-src" : ["self"]  
	},
  "icons": 
	{ 
		"16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png" 
	},
	"content_scripts": [
    {
		"js": [ "JQ.js", "Data.js","functions.js" ], 
	  
		"css": [ "akshay.css" ],

		"matches": [ "https://cntr.one-line.com/*", "http://cntr.one-line.com/*" ],

		"Permission": [ "tabs" ],

		"all_frames": true,

		"run_at": "document_end"
    }
	]
}

