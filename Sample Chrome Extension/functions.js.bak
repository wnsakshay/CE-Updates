function getBLIssueTabSOP()
{
	var pd = null;
	var bt = null;
	
	try{
		pd = document.getElementById("frm_t11sheet1_pod_code").value;
		bt = document.getElementById("frm_t11sheet1_bl_iss_tp_cd").value;
	}
	catch(err){
	}
	
	if( pd != null)
	{
		var POD = document.getElementsByName('frm_t11sheet1_pod_code')[0].value;
		var SubPOD = POD.substring(0,2);
	}
	if(bt != null)
	{
		var BLType = document.getElementsByName('frm_t11sheet1_bl_iss_tp_cd')[0].value;
	}
	if(SubPOD == "BR")
	{
		if(BLType != "B")
		{
			alert("BL Data Type should be 'B' because POD starts with 'BR'.");
			return;
		}
	}
}

function getChargeTabSOP()
{
	var pd = null;
	var dl = null;
	
	try{
		pd = document.getElementById("frm_t10sheet1_pod_cd").value;
		dl = document.getElementsByName("frm_t10sheet1_del_cd")[0].value;
	}
	catch(err){
		
	}
	if(pd != null)
	{
		var POD = document.getElementsByName('frm_t10sheet1_pod_cd')[0].value;
		var SubPOD = POD.substring(0,2);
	}
	if(dl != null)
	{
		var DEL = document.getElementsByName("frm_t10sheet1_del_cd")[0].value; 
		var SubDEL = DEL.substring(0,2);
	}
	if(SubPOD == "BR" || SubDEL == "BR")
	{
		document.querySelector("#t10sheet2 > tbody > tr:nth-child(1) > td:nth-child(1) > div > table > tbody > tr.GMHeaderRow > td.GMWrap0.GMAlignCenter.GMHeaderText.IBSheetFont1.GMCellHeader.IBSheetFont1.HideCol1C32").title = "For Brazil shipment - need to hide( XDD ) charge ID.";
	}
}

function VesselRollOver()
{
	var clr = "";	
	
	db.transaction (
		function(tx){
			tx.executeSql('SELECT * FROM CUSTOMER ORDER BY ROWID DESC LIMIT 1 ;', [],
			function(transaction, results){
				if (results != null && results.rows != null) {
					for (var j=0; j<results.rows.length; j++) 
					{
						var row = results.rows.item(j) ;
						clr = row.clr;
							
						if(clr == "blue")
						{
							if(document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0] != null)
							{
								document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].style.backgroundColor = "#FF0F5F";
								document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].title = "Vessel Roll Over";
							}
						}
						else
						{
							//alert("other");
							//document.getElementsByName("frm_t10sheet1_del_cd")[0].style.backgroundColor = "";
							//document.getElementsByName("frm_t10sheet1_del_cd")[0].title = "";
						}	
					}
				}
			});
		}
	);
}

function setChargeBgColor()
{	
	if(document.getElementsByName('frm_t10sheet1_pod_cd')[0] != null)
	{
		var POD = document.getElementsByName('frm_t10sheet1_pod_cd')[0].value;
		var SubPOD = POD.substring(0,2);
	}
  
	if(document.getElementsByName("frm_t10sheet1_del_cd")[0] != null)
	{
		var DEL = document.getElementsByName("frm_t10sheet1_del_cd")[0].value; 
		var SubDEL = DEL.substring(0,2);
	}
  
	if(SubPOD == "US" || SubPOD == "CA" || SubPOD == "PR" || SubPOD == "AS" || SubPOD == "GU" || SubPOD == "MP" || SubDEL == "US" || SubDEL == "CA" || SubDEL == "PR" || SubDEL == "AS" || SubDEL == "GU" || SubDEL == "MP")
	{
		if(document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0] != null)
		{
			document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].style.backgroundColor = "#f77749";
			document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].title = "1) CRD Date should be auto downloaded for each Container.\r\n2) Retrieve -> Apply -> Save.";
		}
		
		if(document.getElementsByName("frm_t10sheet1_pod_cd")[0] != null)
		{
			document.getElementsByName("frm_t10sheet1_pod_cd")[0].style.backgroundColor = "#f77749";
			document.getElementsByName("frm_t10sheet1_pod_cd")[0].title = "1) CRD Date should be auto downloaded for each Container.\r\n2) Retrieve -> Apply -> Save.";
		}
		
		if(document.getElementsByName("frm_t10sheet1_del_cd")[0] != null)
		{
			document.getElementsByName("frm_t10sheet1_del_cd")[0].style.backgroundColor = "#f77749";
			document.getElementsByName("frm_t10sheet1_del_cd")[0].title = "1) CRD Date should be auto downloaded for each Container.\r\n2) Retrieve -> Apply -> Save.";
		}
		
		if(document.getElementsByName("btn_t10search_date")[0] != null )
		{
			document.getElementsByName("btn_t10search_date")[0].style.backgroundColor = "#f1a9f3";
			document.getElementsByName("btn_t10search_date")[0].title = "1) CRD Date should be auto downloaded for each Container.\r\n2) Retrieve -> Apply -> Save.";
		}
	}
	else
	{	
		if(document.getElementsByName("frm_t10sheet1_pod_cd")[0] != null)
		{
			document.getElementsByName("frm_t10sheet1_pod_cd")[0].style.backgroundColor = "";
			document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].title = "1) For other Trades PF ETD date should be auto downloaded.\r\n2) Retrieve ->  Apply -> Save.";
		}
		
		if(document.getElementsByName("frm_t10sheet1_del_cd")[0] != null)
		{
			document.getElementsByName("frm_t10sheet1_del_cd")[0].style.backgroundColor = "";
			document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].title = "1) For other Trades PF ETD date should be auto downloaded.\r\n2) Retrieve ->  Apply -> Save.";
		}
		
		if(document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0] != null)
		{
			document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].style.backgroundColor = "yellow";
			document.getElementsByName("frm_t10sheet1_rt_aply_dt")[0].title = "1) For other Trades PF ETD date should be auto downloaded.\r\n2) Retrieve ->  Apply -> Save.";
		}
	}
}

function Rating_popup()
{
	if(window.confirm("## Kindly follow below Instructions for Auto Rating : \r\n 1. Check Booking Creation for NAC, If NAC is available select CMDT & A/Customer as per Booking NAC. \r\n 2. Select Rate as per NAC. \r\n 3. If no NAC, then select Rate as per cargo description. \r\n 4. If not found as per cargo description, then FAK Straight/ Consolidation. \r\n 5. If no rates as per above condition, then check Route details. \r\n 6. Then check Route / CMDT/Special Note (Lane/VVD/Validity/NAC/ICD/GOH). \r\n 7. Check Gross weight."))
	{

	}
}

function enable_sameCNEE_chkbx() 
{
    document.getElementById("sam_cnee_copy_flg").disabled = true;    
}

function disable_sameCNEE_chkbx() 
{
    document.getElementById("sam_cnee_copy_flg").disabled = false;    
}

function ICPCheck()
{
	if(document.getElementById("frm_t11sheet1_inet_ctrl_pty_nm").value != "" )
	{
		if(document.getElementById("frm_t11sheet1_inet_ctrl_pty_nm").value != "CN")
		{
			alert("Please check ICP Country Code!");
		}
	}
}

function MDCLAUSE()
{
	var keyword = document.getElementsByName('dg_cmdt_desc')[0].value;
	
	if(keyword.includes('WOOD PACKING') || keyword.includes('WOOD PACKAGE') || keyword.includes('WOOD PACKAGING') || keyword.includes('NWPM') || keyword.includes('WPM') || keyword.includes('WOODEN PACKAGE') || keyword.includes('WOODEN PACKAGING') || keyword.includes('WOODEN PACKING') )
	{
		if(window.confirm("Add 'IT IS STATED BY THE SHIPPER THAT' before the Clause"))
		{
			
		}
	}
	else if(keyword.includes('FUMIGATED SHIPMENT') || keyword.includes('FUMIGATED') )
	{
		if(window.confirm("Add 'SHIPPER DESIRES TO STATE THAT' before the Clause"))
		{
			
		}
	}
	else if(keyword.includes('CARGO QUALITY') || keyword.includes('FEED GRADE') || keyword.includes('GRADE') )
	{
		if(window.confirm("Check SOP & update 'SHIPPER DESIRES TO STATE THAT' before the Clause accordingly"))
		{
			
		}
	}
	else if(keyword.includes('SHIP TO'))
	{
		if(window.confirm("Add 'SHIPPER DESIRES TO STATE THAT' before the Clause"))
		{
			
		}
	}
	else if(keyword.includes('COUNTRY OF ORIGIN') || keyword.includes('ORIGIN') || keyword.includes('MADE IN'))
	{
		if(window.confirm("Add 'SHIPPER DESIRES TO STATE THAT' before the Clause"))
		{
			
		}
	}
	else if(keyword.includes('IN TRANSIT'))
	{
		if(window.confirm("Add 'SHIPPER DESIRES TO STATE THAT' before the Clause"))
		{
			
		}
	}
}

function bkg_DueDiligencePopup()
{
	var POD, DEL, SHCode, CNCode, CNPTCode;
	var flag = 0;
	var ct = ['MM','IQ','LB','YE','RU','UA','BA','RS','BY','CD','LY','SO','SD','SS','ZW','CF','EG','TN','BI','ML','VE','NI', 'TR', 'AE', 'JO'];
	
	if(document.getElementsByName('bkg_pod_cd')[0].value != null)
	{
		POD = document.getElementsByName('bkg_pod_cd')[0].value.substr(0,2);
	}
	if(document.getElementsByName('bkg_del_cd')[0].value != null)
	{
		DEL = document.getElementsByName('bkg_del_cd')[0].value.substr(0,2);
	}
	if(document.getElementsByName('s_cust_cnt_cd')[0].value != null)
	{
		SHCode = document.getElementsByName('s_cust_cnt_cd')[0].value;
	}
	if(document.getElementsByName('c_cust_cnt_cd')[0].value != null)
	{
		CNCode = document.getElementsByName('c_cust_cnt_cd')[0].value;
	}
	if(document.getElementsByName('bkg_ctrl_pty_cust_cnt_cd')[0].value != null)
	{
		CNPTCode = document.getElementsByName('bkg_ctrl_pty_cust_cnt_cd')[0].value;
	}

	if(POD != null && DEL != null)
	{
		for(i=0; i<ct.length; i++)
		{
			if(POD == ct[i] || DEL == ct[i] || SHCode == ct[i] || CNCode == ct[i] || CNPTCode == ct[i])
			{
				flag = 1;
				break;
			}
		}
	}
	
	if(flag == 1)
	{
		alert("Due Diligence Country. Update the screenshot in AppSheet");
	}
}


